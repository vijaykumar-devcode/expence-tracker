PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL=true
DATABASE_POOL_MAX=10
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000
# Required only for isolated PostgreSQL integration tests; never use DATABASE_URL here.
TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5432/expense_tracker_test
TEST_DATABASE_SSL=false
